@model List<GymClub.Models.Member>
@{
    ViewData["Title"] = "المشتركين";
    var todayMap = ViewBag.TodayMap as Dictionary<int, string>;
}
<h2 class="mb-4">لوحة صاحب النادي - المشتركين (@DateTime.Now.ToString("dddd"))</h2>

<form asp-action="Search" method="get" class="d-flex mb-3" style="max-width:400px">
    <input type="text" name="key1" class="form-control me-2" placeholder="بحث بالاسم" />
    <button type="submit" class="btn btn-secondary">بحث</button>
</form>

<a class="btn btn-success mb-3" asp-action="Add">إضافة مشترك جديد</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>الاسم</th>
            <th>بداية الاشتراك</th>
            <th>نهاية الاشتراك</th>
            <th>الحالة</th>
            <th>شو بدو يلعب اليوم</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.MemberId</td>
                <td>@m.Name</td>
                <td>@m.SubscriptionStart.ToString("yyyy-MM-dd")</td>
                <td>@m.SubscriptionEnd.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (m.SubscriptionEnd < DateTime.Now)
                    {
                        <span class="badge bg-danger">منتهي</span>
                    }
                    else
                    {
                        <span class="badge bg-success">فعّال</span>
                    }
                </td>
                <td><span class="badge bg-primary">@todayMap[m.MemberId]</span></td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@m.MemberId">تعديل</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="EditSchedule" asp-route-id="@m.MemberId">الجدول</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="delete" asp-route-id="@m.MemberId"
                       onclick="return confirm('متأكد من الحذف؟')">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
